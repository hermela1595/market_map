{
  "name": "marketmap-ethiopia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MarketMap Ethiopia backend API",
  "main": "server.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.cjs",
    "dev": "nodemon server.cjs",
    "build": "npm run build:client",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build:clint": "npm run build:client",
    "dev:client": "npm --prefix client run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
